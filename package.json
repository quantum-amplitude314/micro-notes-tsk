{
  "name": "notes-taker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @notes/api dev",
    "dev:web": "pnpm --filter @notes/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "podman compose up -d",
    "db:down": "podman compose down",
    "db:migrate": "pnpm --filter @notes/api db:migrate",
    "lint-fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  }
}
